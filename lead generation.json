    {
      "parameters": {
        "promptType": "define",
        "text": "=Write one personalized outreach email for this restaurant.\n\nRestaurant name:\n{{ $json.restaurant_name }}\n\nCategory:\n{{ $json.category }}\n\nCity:\n{{ $json.city }}\n\nWebsite:\n{{ $json.website }}\n\nRating:\n{{ $json.rating }}\n\nReviews:\n{{ $json.reviews }}\n\nDelivery available:\n{{ $json.delivery_available }}\n\nOpportunity:\n{{ $json.opportunity_signals }}\n\nWrite a professional email between 80 and 120 words.\n\nUse the restaurant name exactly as provided.\nDo not use placeholders.\nDo not invent statistics, case studies or results.\n\nReturn valid JSON with two non-empty fields:\nsubject\nemail_body",
        "options": {}
      },
