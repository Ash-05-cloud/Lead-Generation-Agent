    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item, index) => {\n  let raw = item.json.output ?? \"\";\n  let parsed = {};\n  let parse_status = \"ok\";\n\n  // If AI output is already an object\n  if (typeof raw === \"object\" && raw !== null) {\n    parsed = raw;\n  } else {\n    raw = String(raw)\n      .replace(/^```json\\s*/i, \"\")\n      .replace(/^```\\s*/i, \"\")\n      .replace(/\\s*```$/i, \"\")\n      .trim();\n\n    try {\n      parsed = JSON.parse(raw);\n    } catch (error) {\n      // Try extracting JSON from extra text\n      const jsonMatch = raw.match(/\\{[\\s\\S]*\\}/);\n\n      if (jsonMatch) {\n        try {\n          parsed = JSON.parse(jsonMatch[0]);\n        } catch {\n          parse_status = \"invalid_json\";\n        }\n      } else {\n        parse_status = \"invalid_json\";\n      }\n    }\n  }\n\n  const subject = String(parsed.subject ?? \"\").trim();\n\n  const emailBody = String(\n    parsed.email_body ??\n    parsed.emailBody ??\n    parsed.body ??\n    parsed.message ??\n    \"\"\n  ).trim();\n\n  if (!subject || !emailBody) {\n    parse_status = \"missing_subject_or_body\";\n  }\n\n  return {\n    json: {\n      subject,\n      email_body: emailBody,\n      parse_status,\n      raw_ai_output: raw\n    },\n    pairedItem: {\n      item: index\n    }\n  };\n});"
      },
