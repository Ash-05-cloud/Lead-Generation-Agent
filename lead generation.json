    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  const data = item.json;\n\n  const serviceOptions =\n    data.additionalInfo?.[\"Service options\"] || [];\n\n  const hasService = (serviceName) =>\n    serviceOptions.some(\n      (option) => option?.[serviceName] === true\n    );\n\n  const deliveryAvailable =\n    hasService(\"Delivery\") ||\n    hasService(\"No-contact delivery\");\n\n  const websiteListed = Boolean(data.website);\n\n  const orderingLinkListed = Boolean(\n    data.menu ||\n    data.servicesLink ||\n    data.googleFoodUrl\n  );\n\n  const opportunitySignals = [];\n  let leadScore = 0;\n\n  if (!websiteListed) {\n    opportunitySignals.push(\n      \"No website is listed on the Google Maps profile\"\n    );\n    leadScore += 30;\n  }\n\n  if (!orderingLinkListed) {\n    opportunitySignals.push(\n      \"No menu or ordering link is listed in the collected Google Maps data\"\n    );\n    leadScore += 20;\n  }\n\n  if (!deliveryAvailable) {\n    opportunitySignals.push(\n      \"Delivery is not listed in the Google Maps service options\"\n    );\n    leadScore += 25;\n  }\n\n  const rating = Number(data.totalScore || 0);\n  const reviews = Number(data.reviewsCount || 0);\n\n  if (rating > 0 && rating < 4.2) {\n    opportunitySignals.push(\n      `Google rating is ${rating}, indicating a possible reputation-management opportunity`\n    );\n    leadScore += 15;\n  }\n\n  if (reviews > 0 && reviews < 100) {\n    opportunitySignals.push(\n      `The restaurant has only ${reviews} Google reviews`\n    );\n    leadScore += 10;\n  }\n\n  return {\n    json: {\n      place_id: data.placeId || \"\",\n      restaurant_name: data.title || \"\",\n      category: data.categoryName || \"\",\n      address: data.address || \"\",\n      city: data.city || \"\",\n      phone: data.phoneUnformatted || data.phone || \"\",\n      website: data.website || \"\",\n      rating,\n      reviews,\n      google_maps_url: data.url || \"\",\n      delivery_available: deliveryAvailable,\n      ordering_link_listed: orderingLinkListed,\n      opportunity_signals: opportunitySignals.join(\"; \"),\n      lead_score: leadScore,\n      needs_manual_review: leadScore < 25,\n      collected_at: data.scrapedAt || new Date().toISOString()\n    },\n    pairedItem: {\n      item: index\n    }\n  };\n});"
      },
